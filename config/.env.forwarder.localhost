# Localhost forwarder configuration
# Use with vbase/tests/scripts/run_tests_forwarder_localhost.sh; see
# internal/specs/development.md.

VBASE_COMMITMENT_SERVICE_CLASS="ForwarderCommitmentServiceTest"

# Index directly through the local test node. Override this for a localhost
# forwarder backed by another chain; never obtain a private RPC URL from its API.
VBASE_TEST_INDEXING_NODE_RPC_URL="${VBASE_TEST_INDEXING_NODE_RPC_URL:-http://127.0.0.1:8545/}"

# The tests expect the forwarder on port 8081, which leaves port 3000 free for
# other local services. Set VBASE_FORWARDER_PORT for a forwarder on another
# port, such as 3000.
VBASE_FORWARDER_URL="http://127.0.0.1:${VBASE_FORWARDER_PORT:-8081}/forwarder-test/"

# Set an API key that the forwarder accepts in the environment.
# VBASE_API_KEY="YOUR_VBASE_API_KEY"

# The localhost forwarder test runner generates a fresh ephemeral signer for each run.
