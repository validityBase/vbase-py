# Public forwarder dev configuration

VBASE_COMMITMENT_SERVICE_CLASS="ForwarderCommitmentServiceTest"

VBASE_FORWARDER_URL="https://dev.api.vbase.com/forwarder-test/"

# Set the test API key using the environment variable or secrets manager.
# VBASE_API_KEY="YOUR_VBASE_API_KEY"

# Supply VBASE_TEST_INDEXING_NODE_RPC_URL through the environment or a secret
# manager. The forwarder's public RPC endpoint is not an indexing endpoint.

# The public-dev test runner generates a fresh ephemeral signer for each run.

# Block lookback for the shared test indexer; see internal/specs/development.md.
VBASE_TEST_INDEXING_N_LAST_BLOCKS=40000
